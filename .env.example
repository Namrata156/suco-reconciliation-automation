# Template for local dev environment variables read by config/settings.py
# and docker-compose.yml.
#
# Copy this file to `.env` (gitignored) and fill in real dev-only values.
# Never commit `.env` with real credentials.

# --- Django core ---
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# --- PostgreSQL (used by both docker-compose.yml and config/settings.py) ---
POSTGRES_DB=reconciliation
POSTGRES_USER=reconciliation
POSTGRES_PASSWORD=changeme-dev-only
POSTGRES_HOST=localhost
# 5434, not Postgres's default 5432 -- avoids clashing with a native
# Postgres install/service that may already be using 5432 on the host
# (confirmed on at least one dev machine; 5433 was also already taken by
# an unrelated project's container there). Check what's actually free on
# your machine if 5434 is also taken. docker-compose.yml's port mapping
# must match this.
POSTGRES_PORT=5434

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- File Processing Framework ---
FILE_PROCESSING_WORK_DIR=var/file_processing
# Web upload: largest file in bytes (default 150 MB), and where Django keeps
# uploads while they arrive (blank = OS temp folder; use the data drive).
# UPLOAD_MAX_FILE_BYTES=157286400
# FILE_UPLOAD_TEMP_DIR=D:/tmp/uploads

# --- Email alerts (Phase 3; all optional until IT supplies a mail server) ---
# Alerts are always recorded in the Notification outbox (admin: Core >
# Notifications). Nothing is mailed until ALERTS_EMAIL_ENABLED=true AND
# EMAIL_HOST is set. To enable: fill the EMAIL_* keys from IT, set
# ALERTS_EMAIL_ENABLED=true, run `manage.py send_test_email you@bank`, then
# schedule (Windows Task Scheduler / cron; no Celery worker is needed):
#   every 5 minutes : manage.py send_notifications
#   daily           : manage.py send_alert_digest   (at ALERT_DIGEST_TIME)
# First run after a long time disabled: consider
#   manage.py send_notifications --drop-held-older-than 2
# so old held alerts are not mailed in a flood.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_TIMEOUT=
DEFAULT_FROM_EMAIL=
ALERTS_EMAIL_ENABLED=false
# Daily digest time, local (Asia/Kolkata), HH:MM. Default 09:30.
ALERT_DIGEST_TIME=
# Optional: base URL put in front of case links in alerts, e.g. https://recon.bank.local
ALERT_LINK_BASE_URL=
# Optional, for checking only: django.core.mail.backends.console.EmailBackend
# prints mail instead of sending (no EMAIL_HOST needed). Leave blank for SMTP.
EMAIL_BACKEND=

# --- Phase 5 front end (design docs/phase5_design_draft_v1.txt 2.3 / 2.4 / 7.1)
# Development only: the Vite dev server's origin, trusted for CSRF.
# Comma-separated. Leave blank in production (one address for SPA + API).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# true once the intranet address uses HTTPS (P9): Secure session + CSRF cookies.
DJANGO_SECURE_COOKIES=
# Optional: where the production SPA build is; default <project>/frontend/dist.
# Django serves it only when index.html exists there.
FRONTEND_DIST_DIR=
